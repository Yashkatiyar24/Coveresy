{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/admin",
      "destination": "https://coveresy-ops-staging.coveresy.workers.dev/admin"
    },
    {
      "source": "/admin/",
