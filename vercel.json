{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "^/admin(?:/(.*))?$",
      "has": [
        {
          "type": "host",
          "value": "www.coveresy.com"
        }
      ],
      "status": 307,
      "headers": {
        "Location": "https://admin.coveresy.com/$1"
      }
    },
    {
      "src": "^/(.*)$",
      "has": [
        {
          "type": "host",
          "value": "admin.coveresy.com"
        }
      ],
      "dest": "https://coveresy-ops-staging.coveresy.workers.dev/$1"
    },
    {
      "src": "^/api/(.*)$",
      "dest": "/api/index"
    },
    {
      "handle": "filesystem"
    }
  ]
}
